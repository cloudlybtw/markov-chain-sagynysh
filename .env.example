# Token from @BotFather
BOT_TOKEN=
DB_PATH=data/sagynysh.db
COMMON_REPLY_CHANCE=10        # percent chance to reply to an ordinary message
DIRECT_REPLY_CHANCE=10        # percent chance to reply to a reply to the bot
MEME_CHANCE=5                 # share (%) of random replies that become memes
DEMOTIVATOR_CHANCE=5          # share (%); MEME_CHANCE + DEMOTIVATOR_CHANCE <= 100
MARKOV_ORDER=1                # 1..5; higher = more coherent
MAX_WORDS=25                  # hard cap on generated message length
# Optional comma-separated whitelist; empty = any chat
ALLOWED_CHAT_IDS=
# Optional extra bot admins; Telegram group admins are always recognized in their own chat
ADMIN_USER_IDS=
